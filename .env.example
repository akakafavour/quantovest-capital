# Supabase project URL and publishable browser key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-supabase-publishable-key

# Server-only Supabase service key for controlled media uploads and admin jobs
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# Server-only secret for signed, expiring 2FA challenge/completion cookies.
# REQUIRED for 2FA to work. Use a random value of at least 32 characters
# (e.g. generate at https://generate-secret.vercel.app/32 or run:
#   openssl rand -base64 48
# ). Must be set in Vercel AND local .env.local. Do NOT reuse the service role key.
JWT_SECRET=replace-with-a-long-random-secret-64-chars

SUPABASE_MEDIA_BUCKET=quantovest-media

# Database (Supabase Postgres transaction pooler; copy the exact host from Supabase Connect)
# Example for this project’s region: aws-1-eu-west-1.pooler.supabase.com
DATABASE_URL=postgresql://postgres.project-ref:password@aws-1-eu-west-1.pooler.supabase.com:6543/postgres

# Pepper (HMAC key) for 2FA recovery-code hashes. REQUIRED in production:
# without it, codes fall back to legacy unsalted SHA-256. Generate with
#   openssl rand -hex 32
# and set the same value in Vercel AND local .env.local. Never commit the real value.
RECOVERY_CODE_PEPPER=replace-with-a-long-random-hex-pepper

# App URL (used in email templates and redirects)
APP_PUBLIC_URL=http://localhost:3000

# Tawk.to public widget configuration (from the correct production property)
NEXT_PUBLIC_TAWK_PROPERTY_ID=replace-with-tawk-property-id
NEXT_PUBLIC_TAWK_WIDGET_ID=replace-with-tawk-widget-id

# Transactional Email (Zoho SMTP)
# Set up a Zoho Mail mailbox (e.g. support@quantovests.com) and create an
# app-specific password in Zoho for SMTP authentication. Without these,
# emails are logged to console only (dev mode).
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465
ZOHO_SMTP_USER=support@quantovests.com
ZOHO_SMTP_PASS=replace-with-zoho-app-password
EMAIL_FROM=Quantovest Capital <support@quantovests.com>

# Optional OAuth provider credentials.
# Note: Google login is configured in the Supabase dashboard (Authentication ->
# Providers -> Google). These values are for reference only; the app code does
# not read them from the environment.
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
